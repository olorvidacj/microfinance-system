# Mobile (Expo) app - optional override for the backend REST API base URL.
# When unset, the app auto-detects the API host from the Expo dev server and uses port 3000.
EXPO_PUBLIC_API_URL=

# Client Portal auth (Phase 7)
# Set to "dev" (or 1/true/development) to allow demo account credentials in
# development. Leave empty in production to disable demo-mode bypasses.
HOSCOMCO_ALLOW_DEMO=dev
# Require email confirmation before a client account can sign in (1 = on).
HOSCOMCO_REQUIRE_EMAIL_CONFIRM=0
# Where the "forgot password" email's reset CTA points the client after reset.
HOSCOMCO_EMAIL_RESET_REDIRECT=http://localhost:5173/portal/login
# Online savings payments (src/payments/config.ts)
# mock = built-in test provider (no account, no real money; refused in production)
# xendit = Xendit checkout (Invoices) and payouts (Payouts v2)
PAYMENT_PROVIDER=mock
# Xendit secret API key and webhook verification token (server only; never VITE_*).
# In the Xendit dashboard, point the invoice and payout webhooks to
#   <PUBLIC_BASE_URL>/api/payments/webhooks/xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# Instant withdrawals per member per day, in pesos. Above it, members send a branch request.
ONLINE_WITHDRAWAL_DAILY_LIMIT=5000
# Where members reach this server (checkout return links and webhooks), e.g. https://app.example.coop
PUBLIC_BASE_URL=
