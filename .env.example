# Mobile (Expo) app - optional override for the backend REST API base URL.
# When unset, the app auto-detects the API host from the Expo dev server and uses port 3000.
EXPO_PUBLIC_API_URL=

# Client Portal auth (Phase 7)
# Set to "dev" (or 1/true/development) to allow demo account credentials in
# development. Leave empty in production to disable demo-mode bypasses.
HOSCOMCO_ALLOW_DEMO=dev
# Require email confirmation before a client account can sign in (1 = on).
HOSCOMCO_REQUIRE_EMAIL_CONFIRM=0
# Where the "forgot password" email's reset CTA points the client after reset.
HOSCOMCO_EMAIL_RESET_REDIRECT=http://localhost:5173/portal/login