# --- Server -----------------------------------------------------------
PORT=4000
NODE_ENV=development

# --- Supabase (Project Settings -> API) --------------------------------
# Create a FRESH project for the CSFT module and apply database/migrations
# 0001..0010 in order before starting this server.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SERVER-ONLY. Never ship this to frontend/mobile bundles or git history.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed origins (web dashboard, dev servers).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
